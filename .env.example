# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Required: Bharti AI heritage assistant (https://build.nvidia.com) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: assistant model override (default: nvidia/nemotron-3-super-120b-a12b)
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Required in production: auth signing key (any long random string) ---
# Dev fallback exists in code; ALWAYS set this for deployed builds.
# Generate: openssl rand -hex 32
JWT_SECRET=

# --- Required in production: Postgres connection string ---
DATABASE_URL=

# --- Optional: admin actions key ---
ADMIN_KEY=

# --- Optional: S3-compatible object storage (server/storage.ts) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
